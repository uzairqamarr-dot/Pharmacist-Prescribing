# Auto-push working files — local only, never committed
.autopush.log
.autopush.err
.autopush.lockdir/
.DS_Store

# Content bundle for rebuilding elsewhere — not part of the deployed app.
# ANCHORED to the repo root with a leading slash. Without it, this pattern
# matched at any depth and silently excluded hub/prescribing-data.js — the
# 2 MB dataset the hub app loads — so hub/ was pushed without its content
# and would have rendered empty on GitHub Pages.
/prescribing-data.js
